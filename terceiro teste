<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Chat da Loja</title>
	<style>
		* { box-sizing: border-box; }
		body {
			margin: 0;
			min-height: 100vh;
			display: grid;
			place-items: center;
			background: #f1f5f9;
			font-family: Arial, sans-serif;
			color: #172033;
		}
		.chat {
			width: min(420px, 94vw);
			height: 650px;
			display: flex;
			flex-direction: column;
			overflow: hidden;
			background: #fff;
			border-radius: 18px;
			box-shadow: 0 12px 35px #17203322;
		}
		header {
			padding: 20px;
			display: flex;
			align-items: center;
			gap: 12px;
			color: #fff;
			background: #2563eb;
		}
		.avatar {
			width: 44px;
			height: 44px;
			display: grid;
			place-items: center;
			border-radius: 50%;
			background: #fff;
			color: #2563eb;
			font-weight: bold;
		}
		header h1 { margin: 0; font-size: 18px; }
		header p { margin: 4px 0 0; font-size: 13px; opacity: .85; }
		.messages {
			flex: 1;
			padding: 22px 16px;
			overflow-y: auto;
			background: #f8fafc;
		}
		.message {
			max-width: 78%;
			margin: 0 0 14px;
			padding: 11px 14px;
			border-radius: 14px;
			font-size: 14px;
			line-height: 1.4;
		}
		.store { background: #e2e8f0; border-bottom-left-radius: 4px; }
		.customer { margin-left: auto; color: #fff; background: #2563eb; border-bottom-right-radius: 4px; }
		.time { display: block; margin-top: 5px; font-size: 10px; opacity: .65; text-align: right; }
		form {
			display: flex;
			gap: 8px;
			padding: 14px;
			border-top: 1px solid #e2e8f0;
			background: #fff;
		}
		input {
			flex: 1;
			min-width: 0;
			padding: 12px 14px;
			border: 1px solid #cbd5e1;
			border-radius: 10px;
			outline: none;
			font-size: 14px;
		}
		input:focus { border-color: #2563eb; }
		button {
			padding: 0 18px;
			border: 0;
			border-radius: 10px;
			color: #fff;
			background: #2563eb;
			cursor: pointer;
			font-weight: bold;
		}
		button:hover { background: #1d4ed8; }
	</style>
</head>
<body>
	<main class="chat">
		<header>
			<div class="avatar">LG</div>
			<div>
				<h1>Atendimento da Loja</h1>
				<p>Online agora · Responde rapidamente</p>
			</div>
		</header>
		<section class="messages" id="messages" aria-live="polite">
			<div class="message store">Olá! Seja bem-vindo à nossa loja. Como podemos ajudar?<span class="time">10:30</span></div>
			<div class="message customer">Olá! Gostaria de saber mais sobre os produtos disponíveis.<span class="time">10:31</span></div>
			<div class="message store">Claro! Posso ajudar com produtos, preços, entrega ou pedidos.<span class="time">10:31</span></div>
		</section>
		<form id="chat-form">
			<input id="message-input" type="text" placeholder="Digite sua mensagem..." autocomplete="off" required>
			<button type="submit">Enviar</button>
		</form>
	</main>
	<script>
		const form = document.getElementById('chat-form');
		const input = document.getElementById('message-input');
		const messages = document.getElementById('messages');

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const text = input.value.trim();
			if (!text) return;
			const message = document.createElement('div');
			message.className = 'message customer';
			message.innerHTML = `${text.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char])}<span class="time">agora</span>`;
			messages.appendChild(message);
			input.value = '';
			messages.scrollTop = messages.scrollHeight;
		});
	</script>
</body>
</html>
